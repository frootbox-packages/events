{#- An event: text by language, time, place, image and categories in the draft; publishing, times, offline and deleting (decisions 0220, 0227). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}
{% set has_draft = event.draft is not null %}
{% set published = event.published is not null %}
{% set refresh = 'event-detail' %}
{% set self = path('frootbox.events.events.show', {id: event.id}) %}
{% set heading = title ?: t('Without a title') %}

{% block title %}{{ heading }} · {{ t('Events') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg" id="event-detail">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('frootbox.events.events') }}">{{ t('Events') }}</a></p>
            <h1 class="fb-heading-1" tabindex="-1" data-fb-focus>{{ heading }}</h1>
        </div>
        <div class="fb-cluster">
            {% if event.publishAt or event.unpublishAt %}{{ ui.status('scheduled') }}{% endif %}
            {{ ui.status(event.status.value) }}
        </div>
    </header>

    {% for planned in [{at: event.publishAt, text: t('Will be published on {time} by itself.')}, {at: event.unpublishAt, text: t('Goes offline on {time} by itself.')}] %}
        {% if planned.at %}
        {% set parts = planned.text|split('{time}') %}
        {% set text %}{{ parts[0] }}{{ ui.time(planned.at) }}{{ parts[1] ?? '' }}{% endset %}
        {{ ui.alert({tone: 'info', text: text, live: 'none'}) }}
        {% endif %}
    {% endfor %}

    <div class="fb-cluster">
        {% set url = event.urls[language.code] ?? null %}
        {% if url %}{{ ui.button({label: t('View on the website'), href: url, variant: 'outline', icon: 'external', attrs: {target: '_blank', rel: 'noopener'}}) }}{% endif %}
        {% if has_draft and can('frootbox/events/event.publish') %}
        <fb-form action="frootbox/events/event.publish" refresh="{{ refresh }}" done="{{ t('The event is published.') }}">
            <form novalidate>
                <input type="hidden" name="ids[]" value="{{ event.id }}">
                {{ ui.button({label: t('Publish'), type: 'submit'}) }}
            </form>
        </fb-form>
        {% endif %}
        {% if has_draft and can('frootbox/events/event.discard') %}
            {{ ui.button({label: t('Discard the draft'), variant: 'danger', attrs: {commandfor: 'event-discard', command: 'show-modal'}}) }}
        {% endif %}
    </div>

    <section class="fb-card" aria-labelledby="event-content-title">
        <h2 class="fb-visually-hidden" id="event-content-title">{{ t('Content') }}</h2>
        {% if languages|length > 1 %}
        {{ ui.tabs(t('Languages'), languages|map(item => {
            label: item.title,
            href: self ~ '?language=' ~ item.code,
            current: item.code == language.code,
            attrs: {lang: item.code},
        })) }}
        {% endif %}
        <div class="fb-card__body fb-stack">
            {% set editable = can('frootbox/events/event.update') %}
            {% if translation %}
            <fb-form action="frootbox/events/event.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="id" value="{{ event.id }}">
                    {% include '@frootbox/events/backend/fields.twig' with {language: language, translation: translation, slug: true, data: data, image: image, image_value: data.image, chosen: data.categories, editable: editable} only %}
                    {% if editable %}
                    <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}<p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p></div>
                    {% endif %}
                </form>
            </fb-form>
            {% else %}
            <div class="fb-missing">
                <p class="fb-missing__title">{{ t('No version in {language} yet', {language: language.title}) }}</p>
                <p class="fb-muted">{{ t('Visitors in this language do not see the event.') }}</p>
                {% if editable %}
                <fb-form action="frootbox/events/event.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                    <form novalidate>
                        <input type="hidden" name="id" value="{{ event.id }}">
                        <input type="hidden" name="translations.{{ language.code }}.title" value="{{ source.title ?? '' }}">
                        {{ ui.button({label: t('Add the version in {language}', {language: language.title}), type: 'submit', variant: 'tonal', icon: 'plus'}) }}
                    </form>
                </fb-form>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </section>

    {% if can('frootbox/events/event.schedule') %}
    <section class="fb-card fb-card--padded fb-stack" aria-labelledby="event-schedule-title">
        <h2 class="fb-heading-4" id="event-schedule-title">{{ t('Times') }}</h2>
        <fb-form action="frootbox/events/event.schedule" refresh="{{ refresh }}" done="{{ t('Saved') }}">
            <form class="fb-stack" novalidate>
                <input type="hidden" name="id" value="{{ event.id }}">
                {{ ui.field({label: t('Publish on'), name: 'publishAt', id: 'event-publish-at', type: 'datetime-local', optional: true, value: event.publishAt ? event.publishAt|date('Y-m-d\\TH:i') : '', disabled: not has_draft, hint: has_draft ? t('The draft goes online by itself.') : t('Only for a draft.'), attrs: {'data-type': 'datetime', 'data-value': event.publishAt ? event.publishAt|date('c') : null}}) }}
                {{ ui.field({label: t('Take offline on'), name: 'unpublishAt', id: 'event-unpublish-at', type: 'datetime-local', optional: true, value: event.unpublishAt ? event.unpublishAt|date('Y-m-d\\TH:i') : '', disabled: not published, hint: published ? t('The event goes offline by itself.') : t('Only for a published event.'), attrs: {'data-type': 'datetime', 'data-value': event.unpublishAt ? event.unpublishAt|date('c') : null}}) }}
                <div class="fb-form__actions">{{ ui.button({label: t('Save the times'), type: 'submit', saves: true}) }}</div>
            </form>
        </fb-form>
    </section>
    {% endif %}

    {% set can_unpublish = published and can('frootbox/events/event.unpublish') %}
    {% set can_delete = can('frootbox/events/event.delete') %}
    {% if can_unpublish or can_delete %}
    <section class="fb-card fb-card--padded fb-stack" aria-labelledby="event-more-title">
        <h2 class="fb-heading-4" id="event-more-title">{{ t('Offline and delete') }}</h2>
        <div class="fb-cluster">
            {% if can_unpublish %}{{ ui.button({label: t('Take offline'), variant: 'outline', attrs: {commandfor: 'event-unpublish', command: 'show-modal'}}) }}{% endif %}
            {% if can_delete %}{{ ui.button({label: t('Delete the event'), variant: 'danger', attrs: {commandfor: 'event-delete', command: 'show-modal'}}) }}{% endif %}
        </div>
    </section>
    {% endif %}

    {% if has_draft and can('frootbox/events/event.discard') %}
    <dialog class="fb-dialog" id="event-discard" aria-labelledby="event-discard-title">
        <fb-form action="frootbox/events/event.discard" {% if published %}refresh="{{ refresh }}"{% else %}next="{{ path('frootbox.events.events') }}"{% endif %} done="{{ t('The draft is discarded.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ event.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="event-discard-title">{{ t('Discard the draft?') }}</h2>
                    <p>{{ published ? t('Your changes to this event are lost. The published version stays.') : t('The event was never published and is gone afterwards.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Keep the draft'), variant: 'outline', attrs: {commandfor: 'event-discard', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Discard'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if can_unpublish %}
    <dialog class="fb-dialog" id="event-unpublish" aria-labelledby="event-unpublish-title">
        <fb-form action="frootbox/events/event.unpublish" refresh="{{ refresh }}" done="{{ t('The event is offline.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ event.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="event-unpublish-title">{{ t('Take {title} offline?', {title: heading}) }}</h2>
                    <p>{{ t('Visitors no longer find the event. It stays as a draft and can be published again.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'event-unpublish', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Take offline'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if can_delete %}
    <dialog class="fb-dialog" id="event-delete" aria-labelledby="event-delete-title">
        <fb-form action="frootbox/events/event.delete" next="{{ path('frootbox.events.events') }}" done="{{ t('The event is deleted.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ event.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="event-delete-title">{{ t('Delete {title}?', {title: heading}) }}</h2>
                    <p>{{ t('The event leaves the list and the website. Visitors no longer find it.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'event-delete', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Delete for good'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}
</div>
{% endblock %}
