{#- The screen "Events": the events, the latest start first (decisions 0220, 0227). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('Events') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1">{{ t('Events') }}</h1>
            <p class="fb-muted">{{ t('Courses, concerts, open days: anything with a date and a place.') }}</p>
        </div>
        <div class="fb-cluster">
            {% if can('category.update') %}{{ ui.button({label: t('Categories'), href: path('backend.categories') ~ '?group=frootbox/events/categories', variant: 'outline'}) }}{% endif %}
            {% if can('frootbox/events/event.create') %}{{ ui.button({label: t('New event'), href: path('frootbox.events.events.new') ~ (space ? '?space=' ~ space|url_encode : ''), icon: 'plus'}) }}{% endif %}
        </div>
    </header>

    {% if spaces %}
    {{ ui.tabs(t('Spaces'), spaces|map(item => {label: item.title, href: path('frootbox.events.events') ~ '?space=' ~ item.id|url_encode, current: item.id == space})) }}
    {% endif %}

    <section class="fb-card" aria-labelledby="events-events-title">
        <div class="fb-card__header">
            <h2 class="fb-heading-4" id="events-events-title">{{ t('Events') }}</h2>
            {{ ui.badge('neutral', list.total) }}
        </div>
        <form class="fb-card__body fb-cluster" method="get" action="{{ path('frootbox.events.events') }}" role="search">
            {% if space %}<input type="hidden" name="space" value="{{ space }}">{% endif %}
            {{ ui.field({label: t('Search'), name: 'q', id: 'events-search', type: 'search', value: search, placeholder: t('Title')}) }}
            {{ ui.button({label: t('Search'), variant: 'outline', type: 'submit', icon: 'search'}) }}
        </form>
        {% if list.items is empty %}
        <div class="fb-card__body">
            {% if search %}
                {{ ui.empty({icon: 'calendar', title: t('Nothing found'), text: t('Try another search.')}) }}
            {% else %}
                {{ ui.empty({icon: 'calendar', title: t('No events yet'), text: t('Create the first one. It stays a draft until you publish it.'), action: can('frootbox/events/event.create') ? {label: t('New event'), href: path('frootbox.events.events.new') ~ (space ? '?space=' ~ space|url_encode : ''), icon: 'plus'} : null}) }}
            {% endif %}
        </div>
        {% else %}
        <ul>
            {%- for event in list.items %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <a class="fb-list__title fb-list__link" href="{{ path('frootbox.events.events.show', {id: event.id}) }}">{{ event.title ?: t('Without a title') }}</a>
                    <span class="fb-list__meta">{{ ui.time(event.start) }}{% if event.languages|length > 1 %} · {{ event.languages|map(code => code|upper)|join(', ') }}{% endif %}</span>
                </span>
                {% if event.publishAt or event.unpublishAt %}{{ ui.status('scheduled') }}{% endif %}
                {{ ui.status(event.status.value) }}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
    </section>
    {% if list.pages > 1 %}
    <nav class="fb-cluster" aria-label="{{ t('Pages of the list') }}">
        {% if list.page > 1 %}{{ ui.button({label: t('Newer'), href: path('frootbox.events.events') ~ '?' ~ {q: search ?: null, space: space, page: list.page - 1}|url_encode, variant: 'outline', small: true}) }}{% endif %}
        <span class="fb-muted">{{ t('Page {page} of {pages}', {page: list.page, pages: list.pages}) }}</span>
        {% if list.page < list.pages %}{{ ui.button({label: t('Older'), href: path('frootbox.events.events') ~ '?' ~ {q: search ?: null, space: space, page: list.page + 1}|url_encode, variant: 'outline', small: true}) }}{% endif %}
    </nav>
    {% endif %}
</div>
{% endblock %}
