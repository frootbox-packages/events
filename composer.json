{
    "name": "frootbox/events",
    "description": "Events for the Frootbox CMS: dates with place and drafts, categories, upcoming and past events with an address for each, the next events as teasers and a calendar file, and courses with free seats and a booking form from a provider",
    "type": "frootbox-extension",
    "license": "MIT",
    "keywords": [
        "cms",
        "frootbox",
        "events",
        "calendar"
    ],
    "homepage": "https://github.com/Frootbox/frootbox/tree/main/packages/modules/events",
    "support": {
        "issues": "https://github.com/Frootbox/frootbox/issues",
        "source": "https://github.com/frootbox-packages/events",
        "docs": "https://github.com/Frootbox/frootbox/tree/main/documentation"
    },
    "require": {
        "php": ">=8.5",
        "frootbox/core": "^0.1",
        "frootbox/database": "^0.1",
        "frootbox/rich-text": "^0.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "suggest": {
        "frootbox/backend": "Screens for the events and categories"
    },
    "autoload": {
        "psr-4": {
            "Frootbox\\Events\\": "src/",
            "Frootbox\\Events\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Events\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
