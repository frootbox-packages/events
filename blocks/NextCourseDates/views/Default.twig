{# frootbox
title: Courses soon
description: The next dates of the courses, e.g. on the start page, each with the time and a link to the booking or a note how to book.
group: teaser
keywords: [Courses, Dates, Booking, Seats, Next, Upcoming]
options:
  courses: { type: choice, multiple: true, label: Courses, source: frootbox/events/course.choices }
  count: { type: number, label: Number of dates, default: 4, min: 1, max: 12 }
  channel: { type: choice, label: Channel, source: frootbox/events/channel.choices, default: '', description: "Which channel of the provider of courses. A channel only with password shows only on a page with a password." }
fields:
  title: { type: headline, label: Heading, optional: true, maxLength: 100, placeholder: "Courses soon" }
#}
<div class="events-soon">
  {{ heading('title', 0, {class: 'events-soon__title'}) }}
  {% if state == 'none' %}
    {% if editing %}<p class="events-hint">{{ t('No provider of courses is connected yet.') }}</p>{% endif %}
  {% elseif state == 'restricted' %}
    {% if editing %}<p class="events-hint">{{ t('This channel shows only on a page with a password.') }}</p>{% endif %}
  {% elseif state == 'error' %}
    <p class="events-hint">{{ t('The dates cannot be loaded right now.') }}</p>
  {% elseif dates %}
    <ul class="events-soon__items">
      {% for date in dates %}
        <li class="events-soon__item">
          <p class="events-soon__day" aria-hidden="true"><span class="events-soon__number">{{ date.dayNumber }}</span> <span class="events-soon__month">{{ date.month }}</span></p>
          <div class="events-soon__body">
            {{ heading_text(date.course, 1, {class: 'events-soon__course'}) }}
            <p class="events-soon__meta">{% if date.multiDay %}<time datetime="{{ date.start }}">{{ date.time }}</time>{% else %}<time datetime="{{ date.start }}">{{ date.day }}</time>, {{ date.time }}{% endif %}{% if date.venue %}<span aria-hidden="true"> · </span>{{ date.venue }}{% endif %}</p>
            {% if date.bookable and date.seats is not null %}<p class="events-soon__seats">{{ date.seats == 1 ? t('1 seat left') : t('{count} seats left', {count: date.seats}) }}</p>{% endif %}
          </div>
          {% if date.url %}
            <p class="events-soon__link"><a class="events-button" href="{{ date.url }}">{{ t('Book') }}<span class="events-visually-hidden">: {{ date.course }}, {{ date.day }}</span></a></p>
          {% elseif not date.bookable %}
            <p class="events-soon__note">{{ date.state == 'soldOut' ? t('Sold out') : (date.state == 'notYetOpen' ? t('Booking opens soon') : (date.state == 'offline' ? t('Booking by phone or in person') : t('Booking closed'))) }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="events-hint">{{ t('No dates are planned at the moment.') }}</p>
  {% endif %}
</div>
