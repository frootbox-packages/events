{# frootbox
title: Course with dates
description: A course of the provider of courses with price per attendee, the least and most attendees and its coming dates with free seats and a link to the booking.
group: list
keywords: [Courses, Dates, Booking, Seats, Training]
options:
  course: { type: choice, label: Course, source: frootbox/events/course.choices, default: '' }
  channel: { type: choice, label: Channel, source: frootbox/events/channel.choices, default: '', description: "Which channel of the provider of courses. A channel only with password shows only on a page with a password." }
  attendees: { type: boolean, label: Names of the attendees, default: false, description: "Shows who is booked below each date, only on a page with a password." }
  facts: { type: boolean, label: Price and attendees, default: true }
  count: { type: number, label: Number of dates, default: 6, min: 1, max: 20 }
fields:
  title: { type: headline, label: Heading, optional: true, maxLength: 100, placeholder: "Course" }
  subtitle: { type: headline, label: Below the heading, optional: true, maxLength: 100 }
  text: { type: richtext, label: Text, optional: true }
  note: { type: richtext, label: Note on the course, optional: true, description: "Below price and attendees, e.g. that the course also takes place at a company." }
  datesTitle: { type: headline, label: Heading of the dates, optional: true, maxLength: 100, placeholder: "Coming dates" }
#}
<section class="events-course">
  {{ heading('title', 0, {class: 'events-course__title'}) }}
  {% if value('subtitle') or editing() %}<p class="events-course__subtitle">{{ field('subtitle') }}</p>{% endif %}
  <div class="events-course__text">{{ field('text') }}</div>
  {% if state == 'none' %}
    {% if editing %}<p class="events-hint">{{ t('No provider of courses is connected yet.') }}</p>{% endif %}
  {% elseif state == 'restricted' %}
    {% if editing %}<p class="events-hint">{{ t('This channel shows only on a page with a password.') }}</p>{% endif %}
  {% elseif state == 'error' %}
    <p class="events-hint">{{ t('The dates cannot be loaded right now.') }}</p>
  {% elseif facts and course %}
    <table class="events-course__facts">
      <tbody>
        <tr><th scope="row">{{ t('Price per attendee') }}</th><td>{{ course.price ?? (course.free ? t('Free of charge') : '–') }}</td></tr>
        {% if course.min %}<tr><th scope="row">{{ t('Attendees at least') }}</th><td>{{ course.min }}</td></tr>{% endif %}
        {% if course.max %}<tr><th scope="row">{{ t('Attendees at most') }}</th><td>{{ course.max }}</td></tr>{% endif %}
      </tbody>
    </table>
  {% endif %}
  <div class="events-course__note">{{ field('note') }}</div>
  {% if state == 'ready' %}
    {{ heading('datesTitle', 1, {class: 'events-course__dates-title'}) }}
    {% if attendeesHint == 'error' %}
      <p class="events-hint">{{ t('The names of the attendees cannot be loaded right now.') }}</p>
    {% elseif attendeesHint and editing %}
      <p class="events-hint">{{ attendeesHint == 'password' ? t('The names of the attendees show only on a page with a password.') : t('The provider of courses gives no names of attendees.') }}</p>
    {% endif %}
    {% if dates %}
      <ul class="events-dates">
        {% for date in dates %}
          <li class="events-date{% if not date.bookable %} events-date--closed{% endif %}">
            <p class="events-date__when"><time datetime="{{ date.start }}">{{ date.day }}</time><br>{% if date.multiDay %}{{ date.startTime }}<br>{{ t('until {day}', {day: date.until ~ ', ' ~ date.endTime}) }}{% else %}{{ date.time }}{% endif %}</p>
            <p class="events-date__place">{% if date.online %}{{ t('Online') }}{% else %}{{ date.venue }}{% if date.venue and date.address %}<br>{% endif %}{{ date.address }}{% endif %}</p>
            <p class="events-date__booking">
              {% if date.bookable %}
                {% if date.seats is not null %}<span class="events-date__seats">{{ date.seats == 1 ? t('1 seat left') : t('{count} seats left', {count: date.seats}) }}</span>{% endif %}
                {% if date.url %}<a class="events-button" href="{{ date.url }}">{{ t('Book') }}<span class="events-visually-hidden">: {{ date.course }}, {{ date.day }}</span></a>{% endif %}
              {% elseif date.state == 'soldOut' %}
                <span class="events-date__full">{{ t('Sold out') }}</span>
              {% elseif date.state == 'notYetOpen' %}
                <span class="events-date__full">{{ t('Booking opens soon') }}</span>
              {% elseif date.state == 'offline' %}
                <span class="events-date__full">{{ t('Booking by phone or in person') }}</span>
              {% else %}
                <span class="events-date__full">{{ t('Booking closed') }}</span>
              {% endif %}
            </p>
            {% if date.attendees is not null %}
              <div class="events-date__attendees">
                <p class="events-date__attendees-title">{{ date.attendees|length == 1 ? t('1 booked') : t('{count} booked', {count: date.attendees|length}) }}</p>
                {% if date.attendees %}
                  <ul>
                    {% for attendee in date.attendees %}
                      <li>{{ attendee.name }}{% if attendee.booked %} <span class="events-date__booked">({{ t('booked {time}', {time: attendee.booked}) }})</span>{% endif %}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="events-hint">{{ t('No dates are planned at the moment.') }}</p>
    {% endif %}
  {% endif %}
</section>
